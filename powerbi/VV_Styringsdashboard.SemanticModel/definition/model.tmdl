model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["MartMappe","fnLesMart","dim_enhet","dim_periode","dim_indikator","dim_tjenesteomrade","fact_indikator","bro_enhet_rls","_Mål"]

annotation __TEdtr = 1

ref table dim_enhet
ref table dim_periode
ref table dim_indikator
ref table dim_tjenesteomrade
ref table fact_indikator
ref table bro_enhet_rls
ref table _Mål
ref table 'Valgt nivå'
ref table 'Valgt måltall'

ref role Analytiker
ref role HF-leder

ref cultureInfo en-US

